PORT=4000
NODE_ENV=production
JWT_SECRET=your-secure-jwt-secret-key-change-this

# SMTP Email Configuration (e.g. Brevo / SendGrid / AWS SES)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Hierarchy Enterprise" <admin@example.com>

# Frontend URL (or production domain)
APP_URL=http://localhost:5173

# AI Inference (NVIDIA API Catalog / DeepSeek)
AI_PROVIDER=nvidia
AI_API_KEY=your-nvidia-api-key
AI_API_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=deepseek-ai/deepseek-v4-flash-0731
